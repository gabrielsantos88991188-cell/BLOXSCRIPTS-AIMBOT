	end

end)

--==================================================
-- AIM ASSIST
--==================================================

local function GetClosestPlayer()

	local Closest = nil
	local ClosestDistance = FOVSize

	local Center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	for _,Target in ipairs(Players:GetPlayers()) do

		if Target ~= Player
		and Target.Character then

			local Humanoid =
				Target.Character:FindFirstChildOfClass("Humanoid")

			local Head =
				Target.Character:FindFirstChild("Head")

			if Humanoid
			and Humanoid.Health > 0
			and Head then

				local Position,Visible =
					Camera:WorldToViewportPoint(
						Head.Position
					)

				if Visible then

					local ScreenPosition =
						Vector2.new(
							Position.X,
							Position.Y
						)

					local Distance =
						(ScreenPosition-Center).Magnitude

					if Distance <= ClosestDistance then

						ClosestDistance = Distance
						Closest = Head

					end

				end

			end

		end

	end

	return Closest

end

--==================================================
-- LOOP AIM
--==================================================

RunService.RenderStepped:Connect(function()

	if ScriptClosed then
		return
	end

	if not AimEnabled then
		return
	end

	-- IMPORTANTE:
	-- NÃO verifica Window.Visible.
	-- Assim o AIM continua funcionando minimizado.

	local Target = GetClosestPlayer()

	if Target then

		local CameraPosition =
			Camera.CFrame.Position

		local TargetCFrame =
			CFrame.lookAt(
				CameraPosition,
				Target.Position
			)

		local Strength =
			Precision / 100

		Camera.CFrame =
			Camera.CFrame:Lerp(
				TargetCFrame,
				Strength
			)

	end

end)

